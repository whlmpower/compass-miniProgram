# ===== 大模型（StepFun 阶跃星辰，OpenAI 兼容）=====
# 获取地址：https://platform.stepfun.com/interface-key
LLM_API_KEY=your_stepfun_api_key_here
LLM_BASE_URL=https://api.stepfun.com/v1
LLM_MODEL=step-3.7-flash
LLM_TEMPERATURE=0.8
# 演示兜底开关：true=使用内置 mock（无需联网）；默认 false=走真实大模型
LLM_MOCK=false

# ===== 服务 =====
PORT=3001

# ===== v2 鉴权版（封闭分发 + 去广告）=====
# JWT 签名密钥（务必改为随机长字符串，例如：openssl rand -hex 32）
JWT_SECRET=change_me_to_a_random_long_string
# JWT 有效期（小时），默认 24
JWT_EXPIRES_HOURS=24

# 管理员初始手机号 / 密码（首次启动写入存储，admin 密码长期有效，不受 24h 限制）
ADMIN_PHONE=13900000000
ADMIN_PASSWORD=change_me_admin_password

# 用户密码有效期（小时），默认 24（登录成功后 24h 失效）
USER_PWD_TTL_HOURS=24

# 登录失败限流（滑动窗口 24h）
RATE_PHONE_MAX=5
RATE_IP_MAX=10
RATE_WINDOW_HOURS=24
