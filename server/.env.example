# ============================================================
# 职业罗盘 H5 服务端环境变量模板
# ------------------------------------------------------------
# 复制本文件为 .env 后填入真实值：
#   cp .env.example .env
# .env 含密钥，已被 .gitignore 忽略，切勿提交到仓库。
# 所有变量均可选；未设置时使用下方「默认值」对应的值。
# ============================================================

# ---------- 服务基础 ----------
# 监听端口（默认 3001）
PORT=3001

# 运行环境：development / production
# production 会自动开启 cookieSecure、HSTS 等安全项
NODE_ENV=development

# ---------- 大模型（OpenAI 兼容接口） ----------
# API Key（必填，留空则无模型可用；可设 LLM_MOCK=true 走演示兜底）
LLM_API_KEY=
# 接口基地址（默认阶跃星辰 StepFun）
LLM_BASE_URL=https://api.stepfun.com/v1
# 模型名（默认 step-3.7-flash）
LLM_MODEL=step-3.7-flash
# 采样温度 0~1（默认 0.8）
LLM_TEMPERATURE=0.8
# 演示模式：true 时绕过真实大模型（无需 API Key 即可跑通全流程）
LLM_MOCK=false
# 流式输出开关（默认 true = 边生成边返回，首字延迟从 30~90s 降至 1~3s）
# 回滚：设为 false 即降级为「一次性返回」。前后端协议（SSE 帧）保持不变，前端无需改动。
# 注意：生产若走 Nginx 反代，还需在 Nginx 侧关闭 proxy_buffering，见 docs/运维-Nginx与日志查看.md
LLM_STREAM=true
# 对话阶段提示词裁剪（默认 true）
# true 时对话阶段不注入「评分层」（scoring-rubrics.md + weights.md），预填 token 减少约 16%
# 报告生成阶段始终使用全量提示词，不受此项影响
TRIM_CHAT_PROMPT=true

# ---------- 业务规则 ----------
# 单轮用户输入最大字符数（默认 1000）
MAX_INPUT_CHARS=1000
# 报告生成后最多追问轮数（默认 10）
POST_REPORT_TURNS=10
# 报告保留时长（小时，默认 24，超时自动删除）
REPORT_TTL_HOURS=24
# 会话放弃回收天数（默认 3）
ABANDON_TTL_DAYS=3

# ---------- 鉴权 ----------
# JWT 签名密钥（生产环境必改！默认 dev_insecure_secret_change_me 仅为开发占位）
JWT_SECRET=change_me_to_a_long_random_string
# JWT 有效期（小时，默认 24）
JWT_EXPIRES_HOURS=24
# 管理员手机号（用于后台登录，留空则关闭管理员登录）
ADMIN_PHONE=
# 管理员密码（留空等同于关闭）
ADMIN_PASSWORD=
# 普通用户登录态有效期（小时，默认 24）
USER_PWD_TTL_HOURS=24

# ---------- 安全加固 ----------
# 强制 Cookie Secure 属性（true 时要求 HTTPS；NODE_ENV=production 时自动开启）
COOKIE_SECURE=false
# 跨域白名单：前后端不同源时填前端域名（如 https://example.com），同源留空
ALLOWED_ORIGIN=
# 部署在可信反向代理后填 'loopback' / '127.0.0.1' / 'true'，用于获取真实客户端 IP
TRUST_PROXY=false
# 强制开启 HSTS（true 或 NODE_ENV=production 时开启）
ENABLE_HSTS=false
# CSP 内容安全策略（一般无需改；留空用内置默认）
CSP=

# ---------- 限流 ----------
# 单手机号窗口期内最大请求数（默认 5）
RATE_PHONE_MAX=5
# 单 IP 窗口期内最大请求数（默认 10）
RATE_IP_MAX=10
# 限流窗口（小时，默认 24）
RATE_WINDOW_HOURS=24

# ---------- 邮箱自注册（邀请码门控） ----------
# 注册邀请码（必填才开放注册；留空时 verify-invite 一律拒绝）
INVITE_CODE=
# 邮件演示模式：true 时验证码只打印到服务端日志，不真实发信（本地联调用）
EMAIL_MOCK=false
# 阿里云邮件推送（DirectMail）凭证与发件地址
EMAIL_ACCESS_KEY_ID=
EMAIL_ACCESS_KEY_SECRET=
# 发件邮箱地址（需在阿里云控制台完成域名/邮箱验证）
EMAIL_FROM_ADDRESS=
# 发件人显示名（默认 职业罗盘）
EMAIL_FROM_ALIAS=职业罗盘
# 阿里云区域与接入点（一般无需改）
EMAIL_REGION_ID=cn-hangzhou
EMAIL_ENDPOINT=dm.aliyuncs.com
# 验证码策略：有效期（分钟，默认 10）
EMAIL_CODE_TTL_MINUTES=10
# 发送冷却（秒，默认 60）
EMAIL_SEND_COOLDOWN_SECONDS=60
# 单邮箱每小时最多发送次数（默认 5）
EMAIL_MAX_SENDS_PER_HOUR=5
# 验证码最大错误尝试次数（默认 5）
EMAIL_MAX_VERIFY_ATTEMPTS=5

# ---------- 强制密钥校验（可选） ----------
# 设为 true 时，若 JWT_SECRET 仍为默认值会拒绝启动，强制生产环境改密钥
REQUIRE_STRONG_SECRET=false
