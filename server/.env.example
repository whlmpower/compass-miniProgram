# ===== 大模型（StepFun 阶跃星辰，OpenAI 兼容）=====
# 获取地址：https://platform.stepfun.com/interface-key
LLM_API_KEY=your_stepfun_api_key_here
LLM_BASE_URL=https://api.stepfun.com/v1
LLM_MODEL=step-3.7-flash
LLM_TEMPERATURE=0.8
# 演示兜底开关：true=使用内置 mock（无需联网）；默认 false=走真实大模型
LLM_MOCK=false

# ===== 服务 =====
PORT=3001

# ===== 以下为 v2 鉴权版所需（实现时启用）=====
# JWT 签名密钥（请改为随机长字符串）
JWT_SECRET=change_me_to_a_random_long_string
# 管理员初始手机号 / 密码（首次启动写入存储，admin 密码长期有效）
ADMIN_PHONE=13900000000
ADMIN_PASSWORD=change_me_admin_password
